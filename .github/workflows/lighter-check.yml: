
name: Lighter Market Check

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  check-markets:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install requests
        run: pip install requests

      - name: Check Lighter markets
        run: python -u lighter_check.py
